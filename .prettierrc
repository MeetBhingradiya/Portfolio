{

    "tabWidth": 4,
    "arrowParens": "always",
    "singleAttributePerLine": true,
    "bracketSameLine": false,
    "bracketSpacing": true,
    "printWidth": 80,
    "semi": true,
    "trailingComma": "es5",
    "useTabs": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "ignore",
    "vueIndentScriptAndStyle": true,
    "proseWrap": "preserve"
}
