{
    "name": "service",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch index.ts",
        "dev:node": "node --watch --loader ts-node/esm index.ts",
        "start": "node dist/index.js",
        "start:bun": "bun index.ts",
        "build": "tsc --noEmit && bun build index.ts --outdir dist --target node --minify --sourcemap",
        "build:node": "tsc --noEmit && esbuild index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --minify --sourcemap",
        "type-check": "tsc --noEmit",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write \"**/*.{ts,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,json,md}\"",
        "test": "bun test",
        "clean": "rm -rf dist node_modules .turbo",
        "vercel:build": "bun build index.ts --outdir dist --target node --minify",
        "vercel:dev": "vercel dev",
        "deploy": "vercel --prod",
        "deploy:preview": "vercel"
    },
    "devDependencies": {
        "@types/bun": "^1.3.4",
        "@types/express": "^5.0.6",
        "@types/node": "^25.0.2",
        "@typescript-eslint/eslint-plugin": "^8.18.2",
        "@typescript-eslint/parser": "^8.18.2",
        "@vercel/node": "^3.2.27",
        "esbuild": "^0.24.2",
        "eslint": "^9.18.0",
        "eslint-plugin-security": "^3.0.1",
        "prettier": "^3.4.2",
        "ts-node": "^10.9.2"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "express": "^5.2.1"
    },
    "engines": {
        "node": ">=20.0.0",
        "bun": ">=1.0.0"
    }
}
