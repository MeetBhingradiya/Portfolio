# =============================================================================
# NEXT.JS / BUILD
# =============================================================================
# NODE_ENV is auto-set by Next.js (development | production | test)
NEXT_TELEMETRY_DISABLED=1
# NEXT_PHASE is auto-set by Next.js during build (phase-production-build)

# =============================================================================
# APP URLS
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel sets these automatically in production — set locally if needed
# VERCEL_PROJECT_PRODUCTION_URL=https://your-domain.vercel.app
# VERCEL_URL=your-deployment.vercel.app

# =============================================================================
# ADMIN
# =============================================================================
ADMIN_EMAIL=your_admin_email@example.com
NEXT_PUBLIC_ADMIN_EMAIL=your_admin_email@example.com

# =============================================================================
# SECURITY / SIGNATURES
# =============================================================================
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_chars
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars
ADMIN_SIGNATURE=your_admin_signature_secret

# =============================================================================
# DATABASE
# =============================================================================
# Local:
MONGODB_01=mongodb://localhost:27017/PRODUCTION_MeetBhingradiya
# Atlas:
# MONGODB_01=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# =============================================================================
# SMTP / EMAIL
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                     # 465 for SSL, 587 for TLS
SMTP_SECURE=false                 # true when using port 465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password       # Google: https://myaccount.google.com/apppasswords
# SMTP_FROM=your_email@gmail.com  # Optional — overrides the From address

# Email security policy fallback (overridden by admin Features settings if set)
EMAIL_VERIFICATION_WINDOW_MINUTES=720
EMAIL_VERIFICATION_MAX_PER_WINDOW=3

# =============================================================================
# SMS / PHONE OTP (Twilio)
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
# Optional: use Messaging Service instead of direct From number
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phone security policy controls
PHONE_MAX_PER_ACCOUNT=3
PHONE_MAX_ACCOUNTS_PER_NUMBER=3
PHONE_OTP_EXPIRY_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================

# Google — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Microsoft — https://portal.azure.com/
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Apple — https://developer.apple.com/
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret

# =============================================================================
# IMMICH SSO (OpenID Connect bridge for Immich)
# =============================================================================
IMMICH_SSO_CLIENT_ID=immich
IMMICH_SSO_CLIENT_SECRET=your_strong_immich_sso_secret

# Comma-separated list of redirect URIs Immich is allowed to use
IMMICH_SSO_REDIRECT_URIS=https://photos.yourdomain.com/api/oauth/mobile-redirect,https://photos.yourdomain.com/auth/login,https://photos.yourdomain.com/user-settings,https://photos.yourdomain.com

# Static gate key — embed this in the Immich OIDC authorization URL:
#   Authorization URL: https://yourdomain.com/api/immich-sso/authorize?_gate=<this value>
# Any request without this exact key + a valid Origin/Referer from the Immich
# instance will be rejected before the OIDC flow starts.
IMMICH_SSO_GATE_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Optional: persistent RSA private key as JWK (recommended for production)
# Generate:
#   node -e "const {generateKeyPair,exportJWK}=require('jose');(async()=>{ \
#     const k=await generateKeyPair('RS256',{modulusLength:2048}); \
#     const j=await exportJWK(k.privateKey); j.kid='immich-sso-1'; \
#     console.log(JSON.stringify(j)); })()"
IMMICH_SSO_PRIVATE_KEY_JWK={"kty":"RSA","n":"...","e":"AQAB","d":"...","kid":"immich-sso-1"}

# =============================================================================
# GITHUB CDN (multi-repo private storage)
# =============================================================================
# Create private repos named "<PREFIX>-1", "<PREFIX>-2", etc.
# PAT scopes required: repo (full)
# Generate at: GitHub → Settings → Developer settings → Personal access tokens (classic)
CDN_GITHUB_TOKEN=ghp_your_personal_access_token
CDN_GITHUB_OWNER=YourGitHubUsername
CDN_GITHUB_REPO_PREFIX=PrivateCloud
CDN_GITHUB_BRANCH=main
# Soft cap per repo before rolling to the next (default 900 MB = 921600 KB)
CDN_REPO_SIZE_LIMIT_KB=921600


# =============================================================================
# RAZORPAY (https://dashboard.razorpay.com/app/keys)
# =============================================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# =============================================================================
# STRIPE (https://dashboard.stripe.com/apikeys)
# =============================================================================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
# Webhook secret — set after `stripe listen` or in Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx


# =============================================================================
# OTHER SETTINGS
# =============================================================================
# Set to "true" to enable anti-debugging measures in production (also forces it on in development for testing)
ANTI_DEBUG=false