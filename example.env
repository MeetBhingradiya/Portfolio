# =============================================================================
# ENVIRONMENT TEMPLATE — Meet Bhingradiya Portfolio
# =============================================================================
# SECURITY RULES:
# 1) Never commit real secrets.
# 2) Only NEXT_PUBLIC_* keys are exposed to browser code.
# 3) Keep all DB/API/payment secrets server-only.

# =============================================================================
# NEXT.JS / BUILD
# =============================================================================
# NODE_ENV is set by runtime (development | production | test)
NEXT_TELEMETRY_DISABLED=1
# NEXT_PHASE is auto-set by Next.js during build

# =============================================================================
# PUBLIC URLS (safe for client)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel auto-provides in production; set locally only if needed
# VERCEL_PROJECT_PRODUCTION_URL=https://your-domain.vercel.app
# VERCEL_URL=your-deployment.vercel.app

# =============================================================================
# ADMIN / AUTH / SECURITY (server-only)
# =============================================================================
ADMIN_EMAIL=your_admin_email@example.com
NEXT_PUBLIC_ADMIN_EMAIL=your_admin_email@example.com

BETTER_AUTH_SECRET=your_better_auth_secret_min_32_chars
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars
ADMIN_SIGNATURE=your_admin_signature_secret

# Secret vault key for encrypting stored API/provider secrets.
# If omitted, system falls back to BETTER_AUTH_SECRET.
# Recommended: set dedicated value in production.
# AI_PROVIDER_ENCRYPTION_KEY=your_dedicated_secret_vault_key

# =============================================================================
# PRIMARY DATABASE (server-only)
# =============================================================================
MONGODB_01=mongodb://localhost:27017/PRODUCTION_MeetBhingradiya

# Optional explicit URIs for DB Sync Tool (Scripts/DbSyncServer.ts)
# If omitted, MONGODB_SOURCE_URI falls back to MONGODB_01.
MONGODB_SOURCE_URI=mongodb://127.0.0.1:27017/PRODUCTION_MeetBhingradiya
MONGODB_TARGET_URI=mongodb://127.0.0.1:27017/LOCAL_MeetBhingradiya
# Optional DNS servers for SRV resolution issues (comma-separated)
# Example: DB_SYNC_DNS_SERVERS=1.1.1.1,8.8.8.8
DB_SYNC_DNS_SERVERS=

# =============================================================================
# SMTP / EMAIL (server-only)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# SMTP_FROM=your_email@gmail.com

# Fallback email security policy (can be overridden via admin features settings)
EMAIL_VERIFICATION_WINDOW_MINUTES=720
EMAIL_VERIFICATION_MAX_PER_WINDOW=3

# =============================================================================
# SMS / PHONE OTP (Twilio) (server-only)
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
# Optional: use messaging service instead of direct from number
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phone security policy controls
PHONE_MAX_PER_ACCOUNT=3
PHONE_MAX_ACCOUNTS_PER_NUMBER=3
PHONE_OTP_EXPIRY_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5

# =============================================================================
# OAUTH PROVIDERS (server-only)
# =============================================================================
# Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Microsoft
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Apple
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret

# =============================================================================
# IMMICH SSO (server-only)
# =============================================================================
IMMICH_SSO_CLIENT_ID=immich
IMMICH_SSO_CLIENT_SECRET=your_strong_immich_sso_secret

# Comma-separated allowed redirect URIs
IMMICH_SSO_REDIRECT_URIS=https://photos.yourdomain.com/api/oauth/mobile-redirect,https://photos.yourdomain.com/auth/login,https://photos.yourdomain.com/user-settings,https://photos.yourdomain.com

# Static gate key for authorize endpoint
IMMICH_SSO_GATE_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Optional persistent RSA private key as JWK (recommended in production)
IMMICH_SSO_PRIVATE_KEY_JWK={"kty":"RSA","n":"...","e":"AQAB","d":"...","kid":"immich-sso-1"}

# =============================================================================
# GITHUB CDN (server-only)
# =============================================================================
# Create private repos named <PREFIX>-1, <PREFIX>-2, ...
# Token priority:
# 1) CDN_GITHUB_FINE_GRAINED_TOKEN (recommended)
# 2) CDN_GITHUB_TOKEN (classic)
# 3) CDN_GITHUB_CLASSIC_TOKEN (classic alia

# Set Permissons for Fine-Grained Token:
# select specific repos with its Contents & Administration with Read and Write access.s)
CDN_GITHUB_FINE_GRAINED_TOKEN=github_pat_your_fine_grained_token
# CDN_GITHUB_TOKEN=ghp_your_classic_token
# CDN_GITHUB_CLASSIC_TOKEN=ghp_your_classic_token

CDN_GITHUB_OWNER=YourGitHubUsername
CDN_GITHUB_REPO_PREFIX=PrivateCloud
CDN_GITHUB_BRANCH=main
CDN_REPO_SIZE_LIMIT_KB=921600

# Privacy mode: compact repo history to one commit after mutations
CDN_COMPACT_HISTORY=true

# =============================================================================
# PAYMENTS (server-only unless NEXT_PUBLIC_)
# =============================================================================
# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# =============================================================================
# RUNTIME FLAGS
# =============================================================================
ANTI_DEBUG=false