
# =============================================================================
# PRIMARY DATABASE
# =============================================================================
MONGODB_01=mongodb://127.0.0.1:27017/PRODUCTION_MeetBhingradiya
MONGODB_SOURCE_URI=mongodb://127.0.0.1:27017/PRODUCTION_MeetBhingradiya
MONGODB_TARGET_URI=mongodb://127.0.0.1:27017/LOCAL_MeetBhingradiya
DB_SYNC_DNS_SERVERS=1.1.1.1,8.8.8.8

# =============================================================================
# SMTP / EMAIL
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=

# Gmail: Google Account -> Security -> 2-Step Verification -> App passwords.
EMAIL_VERIFICATION_WINDOW_MINUTES=720
EMAIL_VERIFICATION_MAX_PER_WINDOW=3

# =============================================================================
# SMS / PHONE OTP
# =============================================================================
# Twilio Console -> Account Info / API Keys / Messaging Services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

PHONE_MAX_PER_ACCOUNT=3
PHONE_MAX_ACCOUNTS_PER_NUMBER=3
PHONE_OTP_EXPIRY_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Azure Portal -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple Developer -> Certificates, Identifiers & Profiles
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# =============================================================================
# IMMICH SSO
# =============================================================================
IMMICH_SSO_CLIENT_ID=immich
IMMICH_SSO_CLIENT_SECRET=

# Comma-separated allowed redirect URIs
IMMICH_SSO_REDIRECT_URIS=https://photos.yourdomain.com/api/oauth/mobile-redirect,https://photos.yourdomain.com/auth/login,https://photos.yourdomain.com/user-settings,https://photos.yourdomain.com

# Static gate key for authorize endpoint.
IMMICH_SSO_GATE_KEY=

# Generate RSA material with:
# bun Scripts/GenerateRSAKeys.ts
IMMICH_SSO_PRIVATE_KEY_JWK=

# =============================================================================
# GITHUB CDN
# =============================================================================
# GitHub -> Settings -> Developer settings -> Personal access tokens
CDN_GITHUB_FINE_GRAINED_TOKEN=
# CDN_GITHUB_TOKEN=
# CDN_GITHUB_CLASSIC_TOKEN=

CDN_GITHUB_OWNER=
CDN_GITHUB_REPO_PREFIX=PrivateCloud
CDN_GITHUB_BRANCH=main
CDN_REPO_SIZE_LIMIT_KB=921600
CDN_COMPACT_HISTORY=true

# =============================================================================
# PAYMENTS
# =============================================================================
# Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe Dashboard -> Developers -> API keys / Webhooks
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# CORS / PROXY / ORIGIN TRUST
# =============================================================================
TRUSTED_ORIGINS=
CORS_PROXY_ALLOWLIST=api.ipdata.co
CORS_PROXY_KEY=

# =============================================================================
# GEO / IP DATA
# =============================================================================
# ipdata.co dashboard -> API keys
IPDATA_WEBSITE_KEY=
IPDATA_API_KEY=

# =============================================================================
# OPTIONAL CLIENT FLAGS
# =============================================================================
NEXT_PUBLIC_DISABLE_OCR=false
NEXT_PUBLIC_MUI_X_LICENSE_KEY=
